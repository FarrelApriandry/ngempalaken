# LaprakHub — Environment Template

# Neon Serverless PostgreSQL connection string.
# Get it from https://console.neon.tech → your project → Connection Details.
# Example:
#   postgresql://<user>:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Alias kept for backwards-compat with existing local `.env` (the app reads
# DATABASE_URL first, then falls back to NEON_DATABASE_URL).
NEON_DATABASE_URL=${DATABASE_URL}

# Optional: GitHub personal access token to raise REST API rate limits
# (unauthenticated = 60 req/hour, authenticated = 5000 req/hour).
# Server-only — never expose with NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=

# Optional: demo seed control
# SEED_DEMO=true

# Required: session signing secret (min 32 char).
# - App reads SESSION_SECRET first, then AUTH_SECRET fallback.
# - Generate: openssl rand -base64 48
# - Dev/test: boleh kosong/pendek (dipakai apa adanya + warning), atau pakai dev-only fallback.
# - Production: FAIL-CLOSED — missing/weak secret => getSessionSecret() throw + proxy tolak semua
#   sesi dashboard (redirect /login). Jangan deploy tanpa secret kuat.
SESSION_SECRET=change-me-to-at-least-32-chars-long-random-string
# Alias for backwards-compat (used only if SESSION_SECRET empty).
# AUTH_SECRET=${SESSION_SECRET}

# Optional: demo-fallback backdoor control. DEFAULT OFF (jangan set = mati).
# - Hanya berpengaruh bila "true" DAN NODE_ENV != "production".
# - Bila aktif (dev eksplisit saja): halaman dashboard tanpa session boleh memakai akun demo
#   student@laprakhub.local / assistant@laprakhub.local / admin@laprakhub.local (bila sudah di-seed).
# - Di production selalu MATI berapapun nilainya (isDemoFallbackAllowed() hard-check).
# ALLOW_DEMO_FALLBACK=false
